{
  "name": "hrms-sales-platform",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Sales, onboarding and subscription management platform for an HRMS SaaS product",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:i18n": "node scripts/check-i18n.mjs",
    "test:all": "npm run typecheck && npm run test && npm run test:e2e"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@hookform/resolvers": "^7.0.6",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@supabase/supabase-js": "^2.119.0",
    "@tanstack/react-query": "^5.107.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^27.1.3",
    "lucide-react": "^1.73.0",
    "motion": "^14.14.0",
    "nodemailer": "^6.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.92.0",
    "react-i18next": "^18.0.2",
    "react-router-dom": "^6.30.6",
    "recharts": "^2.15.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^2.6.1",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@netlify/functions": "^6.1.1",
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^6.4.24",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.2",
    "jsdom": "^29.1.1",
    "netlify-cli": "^17.38.1",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^6.4.6",
    "vitest": "^3.2.7"
  }
}
