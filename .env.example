# ─────────────────────────────────────────────────────────────
# FRONTEND (bundled into the browser — never put secrets here)
# ─────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
# Optional
VITE_BRAND_NAME=HRMS Cloud
VITE_WHATSAPP_NUMBER=919876543210
VITE_GA_MEASUREMENT_ID=
VITE_SITE_URL=https://your-site.netlify.app

# ─────────────────────────────────────────────────────────────
# SERVER (Netlify Functions only — set in Netlify UI, never VITE_ prefixed)
# ─────────────────────────────────────────────────────────────
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Comma-separated extra origins allowed to call the API (the site's own URL is always allowed)
ALLOWED_ORIGINS=

# Official Meta WhatsApp Cloud API (optional; chargeable messaging stays OFF until enabled in Settings)
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
META_WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=

# Transactional email (optional). EMAIL_PROVIDER: smtp | resend | sendgrid | brevo
#  smtp  → free with Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=you@gmail.com,
#          SMTP_PASS=<16-letter Google App Password>, EMAIL_FROM must be that Gmail address.
#  other → EMAIL_API_KEY from the provider.
EMAIL_PROVIDER=smtp
EMAIL_FROM="HRMS Cloud <you@gmail.com>"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_API_KEY=

# Razorpay (optional, future online payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Azure Blob Storage (optional, large video hosting)
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_KEY=
AZURE_STORAGE_CONTAINER=videos

# Protects the scheduled-jobs endpoint when triggered manually
CRON_SECRET=
